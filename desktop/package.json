{
  "name": "panteao-desktop",
  "productName": "Pantheon",
  "version": "0.3.1",
  "description": "Casca desktop do Pantheon (carrega o site e cuida de login, tray e atualização).",
  "main": "main.js",
  "private": true,
  "author": "Pantheon",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win --dir"
  },
  "build": {
    "appId": "gg.panteao.desktop",
    "productName": "Pantheon",
    "files": [
      "main.js",
      "preload.js",
      "login.html",
      "seletor.html",
      "config.json",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "protocols": [
      {
        "name": "Pantheon",
        "schemes": [
          "panteao"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AqueleSales",
        "repo": "panteao-releases"
      }
    ],
    "artifactName": "Panteao-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
